# Backend env template — copy to `.env` for local development.
# Do not put real production secrets here.
# Source notes: root ENV_VARIABLES.md (gitignored when filled)

NODE_ENV=development
PORT=3000
APP_NAME=Original IQ
APP_URL=http://localhost:5173

# Remote Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres URI (Session pooler preferred on IPv4-only networks)
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TRUST_PROXY=false
LOG_LEVEL=debug
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Mail (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@original-iq.com
MAIL_FROM_NAME=Original IQ

# Cloudflare R2 (S3-compatible). Store object keys in DB; sign URLs at download time.
STORAGE_PROVIDER=r2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true
# Rebuild limits (doc 08): 25 MiB/file, 100 MiB/task, 15m signed URL TTL
STORAGE_MAX_FILE_BYTES=26214400
STORAGE_MAX_TASK_BYTES=104857600
STORAGE_SIGNED_URL_TTL_SEC=900

# Payments: simulated (instant fake checkout) until MontyPay is wired; then montypay
PAYMENT_GATEWAY_MODE=simulated

# MontyPay
MONTYPAY_API_URL=https://checkout.montypay.com/api/v1/session
MONTYPAY_MERCHANT_KEY=
MONTYPAY_MERCHANT_PASSWORD=
MONTYPAY_CALLBACK_SECRET=

# Currency conversion (display only; accounting stays USD). Rates cached in memory.
FX_API_URL=https://open.er-api.com/v6/latest
FX_CACHE_TTL_MS=3600000

# AI / chatbot
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
