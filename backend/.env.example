# Backend env template — copy to `.env` for local development.
# Do not put real production secrets here.

NODE_ENV=development
PORT=3000
APP_NAME=original-iq-api

# Remote Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres URI for migrations (Dashboard → Database → Connect → URI)
# Prefer Session pooler if direct db.* host fails DNS:
# DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated allowlist (never "*")
CORS_ORIGINS=http://localhost:5173

TRUST_PROXY=false

LOG_LEVEL=debug

JSON_BODY_LIMIT=100kb

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
