// Original IQ — domain schema (source of truth for ER diagrams)
// Open in https://dbdiagram.io
// Migrations: backend/migrations/

Project original_iq {
  database_type: 'PostgreSQL'
  Note: 'Tutoring / assignment marketplace domain model'
}

// ─── Enums (logical; SQL uses CREATE TYPE) ───────────────────────────

Enum user_role {
  super
  admin
  coordinator
  tutor
  client
}

Enum task_type {
  assignment
  tutoring
  research
  editing
}

Enum task_status {
  pending
  in_progress [note: 'DB value: in-progress']
  waiting_coordinator_approval
  completed
  cancelled
}

Enum task_payment_status {
  unpaid
  paid
  refund_pending
}

Enum revision_status {
  in_revision
  waiting_coordinator_approval
  completed
  cancelled
}

Enum payment_status {
  pending
  paid
  failed
  canceled
  refunded
}

Enum invoice_status {
  sent
  failed
}

Enum login_verification_type {
  email
  password_reset
}

Enum assignment_transaction_type {
  assigned
  reassigned
  completed
  cancelled
}

Enum message_status {
  unread
  read
}

// ─── Core identity ───────────────────────────────────────────────────

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(120) [not null]
  email varchar(255) [not null, unique]
  password_hash text [not null]
  role user_role [not null, default: 'client']
  phone varchar(40)
  email_verified boolean [not null, default: false]
  email_verified_at timestamptz
  permissions jsonb [note: 'legacy admin keys; prefer user_permissions']
  is_active boolean [not null, default: true]
  last_login_at timestamptz
  nb_done int [not null, default: 0, note: 'tutor completed count']
  punctuality numeric(5,2) [not null, default: 0]
  quality numeric(5,2) [not null, default: 0]
  perfection numeric(5,2) [not null, default: 0]
  avg_rating_star numeric(3,2) [not null, default: 0]
  start_date date [note: 'tutor start']
  remember_token varchar(255)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Single role column — no user_type'
}

// ─── RBAC catalog (editable matrix; runtime gate still users.role) ───

Table roles {
  id uuid [pk, default: `gen_random_uuid()`]
  key varchar(64) [not null, unique, note: 'matches users.role for system roles']
  name varchar(120) [not null]
  description text
  is_system boolean [not null, default: false]
  sort_order int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  key varchar(80) [not null, unique]
  name varchar(120) [not null]
  description text
  category varchar(64) [not null, default: 'general']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table role_permissions {
  role_id uuid [not null, ref: > roles.id]
  permission_id uuid [not null, ref: > permissions.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (role_id, permission_id) [pk]
  }
}

Table user_permissions {
  user_id uuid [not null, ref: > users.id]
  permission_id uuid [not null, ref: > permissions.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, permission_id) [pk]
  }
}

Table activity_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [ref: > users.id]
  action varchar(120) [not null]
  entity varchar(80)
  entity_id varchar(80)
  meta jsonb
  ip varchar(45)
  request_id varchar(64)
  created_at timestamptz [not null, default: `now()`]
}

Table error_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  request_id varchar(64)
  user_id uuid [ref: > users.id]
  code varchar(80)
  message text [not null]
  stack text
  path text
  method varchar(16)
  status int
  created_at timestamptz [not null, default: `now()`]
}

Table specializations {
  id uuid [pk, default: `gen_random_uuid()`]
  tutor_id uuid [not null, ref: > users.id]
  name varchar(120) [not null]
  note text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ─── Tasks & deliverables ────────────────────────────────────────────

Table tasks {
  id uuid [pk, default: `gen_random_uuid()`]
  client_id uuid [not null, ref: > users.id]
  tutor_id uuid [ref: > users.id]
  coordinator_id uuid [ref: > users.id]
  topic varchar(255)
  type task_type
  description text [note: 'logical field desc']
  is_assigned boolean [not null, default: false]
  status task_status [not null, default: 'pending']
  deadline timestamptz
  price numeric(8,2) [not null, default: 0]
  payment_status task_payment_status [not null, default: 'unpaid']
  category varchar(120)
  feedback text [note: 'legacy/extra field on task']
  allow_view boolean [not null, default: false, note: 'client solution visibility']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table files {
  id uuid [pk, default: `gen_random_uuid()`]
  task_id uuid [not null, ref: > tasks.id]
  file_location text [not null, note: 'R2 object key, not public URL']
  original_name varchar(255)
  content_type varchar(120)
  size_bytes bigint
  note text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table solutions {
  id uuid [pk, default: `gen_random_uuid()`]
  task_id uuid [not null, ref: > tasks.id]
  file_location text [not null, note: 'R2 object key, not public URL']
  original_name varchar(255)
  content_type varchar(120)
  size_bytes bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table revision_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  task_id uuid [not null, ref: > tasks.id]
  start_date timestamptz
  deadline timestamptz
  submit_date timestamptz
  status revision_status [not null, default: 'in_revision']
  title text
  description text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table revision_session_solutions {
  id uuid [pk, default: `gen_random_uuid()`]
  revision_session_id uuid [not null, ref: > revision_sessions.id]
  solution_id uuid [not null, ref: > solutions.id]
  date timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ─── Payments ────────────────────────────────────────────────────────

Table payments {
  id uuid [pk, default: `gen_random_uuid()`]
  task_id uuid [not null, ref: > tasks.id]
  user_id uuid [not null, ref: > users.id, note: 'payer (client)']
  amount numeric(10,2) [not null]
  currency varchar(3) [not null, default: 'USD']
  gateway varchar(64) [not null, default: 'montypay']
  montypay_transaction_id varchar(128) [unique, note: 'unique where not null']
  status payment_status [not null, default: 'pending']
  payment_url text
  payment_method varchar(64)
  callback_payload jsonb
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table payment_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  payment_id uuid [not null, ref: > payments.id]
  event varchar(120) [not null]
  payload jsonb
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table refunds {
  id uuid [pk, default: `gen_random_uuid()`]
  task_id uuid [not null, ref: > tasks.id]
  refunder_id uuid [not null, ref: > users.id]
  amount numeric(10,2) [not null]
  refund_reason text
  currency varchar(3) [not null, default: 'USD']
  gateway varchar(64) [not null]
  montypay_transaction_id varchar(128)
  status payment_status [not null, default: 'pending']
  payment_url text
  payment_method varchar(64)
  callback_payload jsonb
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table invoices {
  id uuid [pk, default: `gen_random_uuid()`]
  payment_id uuid [not null, unique, ref: - payments.id]
  invoice_number varchar(32)
  invoice_date timestamptz
  invoice_status invoice_status
  pdf_path text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ─── Feedback ────────────────────────────────────────────────────────

Table feedbacks {
  id uuid [pk, default: `gen_random_uuid()`]
  task_id uuid [not null, ref: > tasks.id]
  tutor_id uuid [not null, ref: > users.id]
  client_id uuid [not null, ref: > users.id]
  rating int [note: 'unsigned in app layer']
  comments text
  suggestions text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ─── Marketing / contact ─────────────────────────────────────────────

Table leads {
  id uuid [pk, default: `gen_random_uuid()`]
  first_name varchar(80)
  last_name varchar(80)
  phone varchar(40)
  email varchar(255)
  country varchar(80)
  zip varchar(20)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table stay_updated {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table contact_messages {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(120) [not null]
  email varchar(255) [not null]
  subject varchar(255)
  message text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ─── Auth security ───────────────────────────────────────────────────

Table login_attempts {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [not null]
  ip_address varchar(45) [not null]
  user_agent text
  success boolean [not null, default: false]
  failed_attempts int [not null, default: 0]
  locked_until timestamptz
  last_attempt_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (email, ip_address)
    locked_until
  }
}

Table login_verifications {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  code varchar(6) [not null]
  type login_verification_type [not null, default: 'email']
  expires_at timestamptz [not null]
  used boolean [not null, default: false]
  used_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ─── Optional / legacy ───────────────────────────────────────────────

Table messages {
  id uuid [pk, default: `gen_random_uuid()`]
  sender_id uuid [not null, ref: > users.id]
  receiver_id uuid [not null, ref: > users.id]
  subject varchar(255)
  content text [not null]
  status message_status [not null, default: 'unread']
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Optional / unused UX — keep only if needed'
}

Table assignment_transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  task_id uuid [not null, ref: > tasks.id]
  coordinator_id uuid [ref: > users.id]
  tutor_id uuid [ref: > users.id]
  type assignment_transaction_type [not null]
  date timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Optional / unused writes — keep only if needed'
}
