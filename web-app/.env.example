# Development — Vite loads this for `npm run dev`
# Never put service-role keys, R2 secrets, or payment secrets here.

VITE_APP_ENV=development
VITE_APP_NAME=Original IQ
VITE_APP_URL=http://localhost:5173
# Optional. Omit to use same-origin `/api/v1` (Vite dev proxy locally, `backend` service on Vercel).
VITE_API_BASE_URL=http://localhost:3000/api/v1
